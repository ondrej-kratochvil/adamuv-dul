// Schoolcraft na Cloudflare: hra z dist a API (worker/index.ts), databáze D1 v EU, doména schoolcraft.games.
// Nasazuje GitHub Actions (.github/workflows/test-a-nasazeni.yml) s tokenem v tajných proměnných repozitáře.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolcraft",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "8d64b5a0fd7de947c22c910ce2fa3c09",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/.well-known/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "schoolcraft", "database_id": "71f73b1a-866a-4dfa-9356-debaa1d9fd44", "migrations_dir": "worker/migrations" }
  ],
  "routes": [{ "pattern": "schoolcraft.games", "custom_domain": true }],
  // omezení počtu požadavků (31. 10. 2026): RL_API běžné volání (hráč nebo IP), RL_NEW zakládání hráčů, skupin a upozornění (IP)
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_NEW", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } },
    // přirozený hlas (7. a 9. 11. 2026, IP): RL_TTS všechny požadavky na /api/tts, RL_TTS_NEW jen nové věty (platí se u Googlu)
    { "name": "RL_TTS", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_TTS_NEW", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } }
  ],
  // strop znaků poslaných Googlu (Honza 9. 11. 2026: denně 100 tisíc; měsíčně 1 milion = volný limit Chirp 3 HD), pak hlas tabletu
  "vars": { "TTS_DAY_CHARS": "100000", "TTS_MONTH_CHARS": "1000000" },
  // ranní upozornění: každou celou hodinu (UTC); worker/index.ts morning() vybere zařízení podle českého času
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
